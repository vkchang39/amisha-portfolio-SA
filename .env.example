# Copy to .env.local and fill in. All optional — features hide when unset.

# Contact form relay (Web3Forms shown; Formspree also works — omit the access key)
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Cookieless analytics: your GoatCounter site code (https://<code>.goatcounter.com)
NEXT_PUBLIC_GOATCOUNTER=
